# Copy to .env and fill in. `task dev` reads this file via docker-compose's
# env_file / --env-file. Never commit the real .env — see .gitignore.

# --- hdms-api ---------------------------------------------------------

# development | test | production
HDMS_ENV=development

# The address the API listens on inside its container.
HDMS_HTTP_ADDR=:8443

# Postgres connection string. The compose `db` service maps container port
# 5432 to host port 5442 (not 5432) to stay out of the way of other local
# Postgres instances — the `api` container itself always reaches it at
# db:5432 on the compose network, regardless of this value. Override this
# for a native (non-compose) `go run`.
HDMS_DATABASE_URL=postgres://hdms:hdms@localhost:5442/hdms?sslmode=disable

# mkcert-issued local dev certificate (see `task certs`). Required — the
# kiosk's camera fallback (BarcodeDetector) refuses to run over plain HTTP.
HDMS_TLS_CERT_FILE=certs/localhost.pem
HDMS_TLS_KEY_FILE=certs/localhost-key.pem

# HMAC pepper for credential tokens (docs/05-credentials-and-labeling.md).
# Held outside the database on purpose: a leaked backup alone must not
# yield working cards. Generate a real one with `openssl rand -hex 32`.
HDMS_TOKEN_PEPPER=dev-only-pepper-change-me

# How long an idle kiosk scan session survives before expiring.
HDMS_SESSION_TTL=25s

# OpenTelemetry OTLP/HTTP collector endpoint. Empty = export traces to
# stdout instead, which is what local dev does by default.
HDMS_OTLP_ENDPOINT=

# debug | info | warn | error
HDMS_LOG_LEVEL=info

# --- Postgres (compose) ------------------------------------------------

POSTGRES_USER=hdms
POSTGRES_PASSWORD=hdms
POSTGRES_DB=hdms
