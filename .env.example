# Copy to .env and fill in. `task dev` reads this file via docker-compose's
# env_file / --env-file. Never commit the real .env — see .gitignore.

# --- hdms-api ---------------------------------------------------------

# development | test | production
HDMS_ENV=development

# The address the API listens on inside its container.
HDMS_HTTP_ADDR=:8443

# Postgres connection string. The compose `db` service maps container port
# 5432 to host port 5442 (not 5432) to stay out of the way of other local
# Postgres instances — the `api` container itself always reaches it at
# db:5432 on the compose network, regardless of this value. Override this
# for a native (non-compose) `go run`.
HDMS_DATABASE_URL=postgres://hdms:hdms@localhost:5442/hdms?sslmode=disable

# mkcert-issued local dev certificate (see `task certs`). Required — the
# kiosk's camera fallback (BarcodeDetector) refuses to run over plain HTTP.
HDMS_TLS_CERT_FILE=certs/localhost.pem
HDMS_TLS_KEY_FILE=certs/localhost-key.pem

# HMAC pepper for credential tokens (docs/05-credentials-and-labeling.md).
# Held outside the database on purpose: a leaked backup alone must not
# yield working cards. Generate a real one with `openssl rand -hex 32`.
HDMS_TOKEN_PEPPER=dev-only-pepper-change-me

# AES-256-GCM key for reversible device-credential token storage — only
# device stickers are stored this way, so a genuine reprint is possible
# (docs/05-credentials-and-labeling.md); staff cards are never recoverable
# and must be reissued instead. Standard base64 of 32 raw bytes. Generate a
# real one with `openssl rand -base64 32`.
HDMS_CREDENTIAL_ENC_KEY=O4CAtFId3Jh5por/68sf2I8KracP/ylyP+HjDYsrQac=

# How long an idle kiosk *scan* session survives before expiring. Unrelated
# to admin login — see HDMS_ADMIN_SESSION_TTL below.
HDMS_SESSION_TTL=25s

# AES-256-GCM key for admin TOTP secrets at rest (admin_accounts.totp_secret_enc).
# Deliberately separate from HDMS_CREDENTIAL_ENC_KEY — different secret,
# different blast radius if one leaks. Standard base64 of 32 raw bytes.
# Generate a real one with `openssl rand -base64 32`.
HDMS_TOTP_ENC_KEY=SPCdq6Fv9PRz8jMr3UxAPIaUioFtcwtavZ1kSrtfCfE=

# How long an admin login session survives, with sliding renewal on every
# authenticated request (docs/09-security-privacy-ops.md).
HDMS_ADMIN_SESSION_TTL=12h

# OpenTelemetry OTLP/HTTP collector endpoint. Empty = export traces to
# stdout instead, which is what local dev does by default.
HDMS_OTLP_ENDPOINT=

# debug | info | warn | error
HDMS_LOG_LEVEL=info

# --- Postgres (compose) ------------------------------------------------

POSTGRES_USER=hdms
POSTGRES_PASSWORD=hdms
POSTGRES_DB=hdms

# --- Local browser / Playwright testing --------------------------------
# Development-only sample account. Create it with command in
# `.playwright/memory.md`; `task seed` only applies migrations today.
HDMS_TEST_ADMIN_EMAIL=admin@example.org
HDMS_TEST_ADMIN_PASSWORD=correct horse battery staple
HDMS_TEST_ADMIN_TOTP_SECRET=VIPF7BGMNRBOPVSVYOIAG33Q5NHWVOZ7
