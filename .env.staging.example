# Copy to .env.staging and fill in with dedicated staging secrets.
# Used by `task staging:up` and `task staging:seed`.
# Never commit the real .env.staging.

# --- Environment & Server ----------------------------------------------
HDMS_ENV=staging
HDMS_HTTP_ADDR=:8443
HDMS_RATE_LIMIT=on
HDMS_LOG_LEVEL=info

# --- Postgres (Staging Database) ---------------------------------------
# Maps to host port 5443 (dev is 5442, local default is 5432)
# In production, migrations run as table owner (e.g. hdms_prod / postgres),
# while the application runtime connects as hdms_app (INV-8 append-only audit role).
POSTGRES_USER=hdms_staging
POSTGRES_PASSWORD=staging-db-password-change-me
POSTGRES_DB=hdms_staging

# Host connection string for CLI commands (`task staging:seed` from host)
# Note: In production (HDMS_ENV=production), the application DSN user is hdms_app.
HDMS_DATABASE_URL=postgres://hdms_staging:staging-db-password-change-me@localhost:5443/hdms_staging?sslmode=disable

# --- TLS (Staging) -----------------------------------------------------
HDMS_TLS_CERT_FILE=certs/localhost.pem
HDMS_TLS_KEY_FILE=certs/localhost-key.pem

# --- Secrets (Generate dedicated staging keys - do NOT reuse dev/prod) -
# openssl rand -hex 32
HDMS_TOKEN_PEPPER=a1b2c3d4e5f60718293a4b5c6d7e8f90123456789abcdef0123456789abcdef0

# openssl rand -base64 32
HDMS_CREDENTIAL_ENC_KEY=7Xq+8Yt0K9jNmP2wZ5vL4rQ1sT8uV3xY0zA2bC4dE6g=
HDMS_TOTP_ENC_KEY=9Kx+2Vt4M8pQmR1wY6vL3rS0tT7uU2xW9zA1bC3dE5h=

# --- Nightly backup (5.4a, staging) --------------------------------------
# Staging target is local disk; production points at the NAS/offsite mount.
HDMS_BACKUP_DIR=/var/backups/hdms-staging
# openssl rand -base64 32 — dedicated staging key, do NOT reuse dev/prod.
# Stored separately from the backups; see docs/runbooks/nightly-backup.md.
HDMS_BACKUP_ENC_KEY=RSZYkv0y3gmXJPvT6xaBpodWdC3sm05qFdJQwJ10/k8=

# --- Session TTLs ------------------------------------------------------
HDMS_SESSION_TTL=25s
HDMS_ADMIN_SESSION_TTL=12h
HDMS_STAFF_SESSION_TTL=12h

# --- Optional External Integrations (Staging) --------------------------
HDMS_ENTRA_TENANT_ID=
HDMS_ENTRA_CLIENT_ID=
HDMS_ENTRA_CLIENT_SECRET=
HDMS_ENTRA_REDIRECT_URL=https://localhost:8443/v1/staff/auth/microsoft/callback
HDMS_ENTRA_ALLOWED_EMAIL_DOMAINS=
HDMS_OTLP_ENDPOINT=

# --- SMTP Relay (Phase 6.2c, Staging) ----------------------------------
HDMS_SMTP_HOST=smtp.staging.hospital
HDMS_SMTP_PORT=587
HDMS_SMTP_USERNAME=hdms-staging
HDMS_SMTP_PASSWORD=staging-smtp-password-change-me
HDMS_SMTP_FROM_ADDRESS=hdms-staging@hospital.org
HDMS_SMTP_REPLY_ADDRESS=counter@hospital.org

# --- Frontend Staging Indicators ---------------------------------------
VITE_ENV=staging
VITE_API_BASE_URL=https://localhost:9443/v1
