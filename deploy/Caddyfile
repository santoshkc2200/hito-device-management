# Local dev TLS front door. Terminates HTTPS with the mkcert certificate so
# the kiosk's camera fallback (BarcodeDetector) — which refuses to run over
# plain HTTP — works the same way it will in front of the real deploy,
# where Caddy holds a real certificate instead of a local one.
#
# Security headers boundary (5.2a):
# The Go application (httpx.WithSecurityHeaders) is the authoritative source
# for all security headers (HSTS, CSP, X-Content-Type-Options, Referrer-Policy,
# X-Frame-Options). Caddy terminates TLS and handles CORS preflight (@options)
# without injecting or duplicating security headers on reverse_proxy responses.
{
	auto_https off
}

https://localhost:8443 {
	tls /certs/localhost.pem /certs/localhost-key.pem

	@options {
		method OPTIONS
	}
	handle @options {
		header ?Access-Control-Allow-Origin "https://localhost:5173"
		header ?Access-Control-Allow-Methods "GET, POST, DELETE, OPTIONS"
		header ?Access-Control-Allow-Headers "Authorization, Content-Type, Idempotency-Key, Cache-Control, X-CSRF-Token"
		header ?Access-Control-Max-Age "3600"
		respond 204
	}

	# Recovery API (plan 3b): straight to the worker, as in production. The
	# recovery Vite server (:5176) proxies /recovery/api here.
	handle /recovery/api/* {
		reverse_proxy worker:8090 {
			header_up X-Forwarded-For {http.request.remote.host}
		}
	}

	handle {
		reverse_proxy api:8443 {
			transport http {
				tls_insecure_skip_verify
			}
		}
	}
}
