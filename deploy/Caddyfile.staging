# Staging front door. Same shape as the production Caddyfile
# (deploy/production/Caddyfile) — baked /srv/* frontends, /v1/* proxied with
# X-Forwarded-For overwritten (THR-01) — on a separate host port so the
# staging stack and the dev stack can run side by side. A drill against
# staging must never require taking the dev environment down.
#
# Security headers boundary (5.2a):
# The Go application (httpx.WithSecurityHeaders) is the authoritative source
# for all security headers (HSTS, CSP, X-Content-Type-Options, Referrer-Policy,
# X-Frame-Options). Caddy terminates TLS and routes without injecting or
# duplicating security headers on reverse_proxy responses.
{
	auto_https off
}

# Site address is the bare port, not localhost:9443, so testers on the LAN can
# reach staging by the host's IP or hostname (deploy/staging-lan.ps1 issues a
# certificate that covers those names).
:9443 {
	tls /certs/localhost.pem /certs/localhost-key.pem

	log {
		output stdout
		format json
	}

	handle /v1/* {
		reverse_proxy api:8443 {
			transport http {
				tls_insecure_skip_verify
			}
			header_up X-Forwarded-For {http.request.remote.host}
			header_up X-Real-IP {http.request.remote.host}
		}
	}

	handle /admin/* {
		root * /srv/admin
		uri strip_prefix /admin
		try_files {path} /index.html
		file_server
	}

	handle /staff/* {
		root * /srv/staff
		uri strip_prefix /staff
		try_files {path} /index.html
		file_server
	}

	handle {
		root * /srv/kiosk
		try_files {path} /index.html
		file_server
	}
}
