# Production secrets template (Phase 5.3a).
#
# Copy to the ROOT-ONLY host file /etc/hdms/hdms.env (mode 0600, root:root)
# and fill in — never commit the real file. Invoked as:
#   docker compose -f deploy/production/compose.yaml --env-file /etc/hdms/hdms.env up -d --build
#
# 5.3c backs TOKEN_PEPPER and DEVICE keys up to the hospital password
# manager and records the entry name in the runbook; the pepper is NOT
# rotatable without reissuing every credential.

# --- Environment -------------------------------------------------------
HDMS_ENV=production
HDMS_LOG_LEVEL=info
# Local time zone for scheduled jobs (backup at 02:00 means 02:00 here).
TZ=Asia/Tokyo

# --- Postgres (production database, NOT published to the host) ---------
POSTGRES_USER=hdms_prod
POSTGRES_PASSWORD=change-me-32-chars-minimum-from-the-vault
POSTGRES_DB=hdms_prod

# The API connects as the restricted runtime role (INV-8). The database is
# reachable only on the private compose network and the Postgres container has
# no TLS, so sslmode=disable. The worker sets hdms_app's password from
# HDMS_APP_DB_PASSWORD at start — no hand-run ALTER ROLE.
HDMS_DATABASE_URL=postgres://hdms_app:change-me-app-password@db:5432/hdms_prod?sslmode=disable
HDMS_APP_DB_PASSWORD=change-me-app-password
# Owner DSN, used only by the worker for migrations and backups. Same user and
# password as POSTGRES_USER / POSTGRES_PASSWORD above.
HDMS_OWNER_DATABASE_URL=postgres://hdms_prod:change-me-32-chars-minimum-from-the-vault@db:5432/hdms_prod?sslmode=disable

# --- TLS (5.3b issues for the internal hostname from the 5.0a CA) -------
# Container paths are fixed by compose.yaml; host paths are overridable for
# verification (HDMS_TLS_CERT_HOST_PATH / HDMS_TLS_KEY_HOST_PATH).
# HDMS_SITE_ADDR is the Caddy site address (default hdms.hospital.local).
HDMS_SITE_ADDR=hdms.hospital.local
HDMS_HTTPS_PORT=443
HDMS_HTTP_PORT=80

# --- Secrets (generate fresh production values, never reuse dev/staging) -
# openssl rand -hex 32
HDMS_TOKEN_PEPPER=change-me-openssl-rand-hex-32
# openssl rand -base64 32 (each)
HDMS_CREDENTIAL_ENC_KEY=change-me-openssl-rand-base64-32
HDMS_TOTP_ENC_KEY=change-me-openssl-rand-base64-32
# openssl rand -base64 32 — backup encryption key, stored SEPARATELY from
# the backups (password manager + root-only env file).
HDMS_BACKUP_ENC_KEY=change-me-openssl-rand-base64-32
HDMS_BACKUP_DIR=/var/backups/hdms
# Optional: a host directory where IT has mounted the NAS share (NFS/SMB).
# It appears inside the worker as /mnt/nas. Leave unset for local-only copies.
# HDMS_BACKUP_NAS_HOST_PATH=/mnt/hospital-nas/hdms

# --- Scheduled jobs (5.5e) -------------------------------------------------
# Retention mode for `hdms-cli retention` (docs/runbooks/retention.md).
# Stays "report" until Q7 is answered IN WRITING by hospital compliance;
# only then may it become "enforce". A misspelled value fails closed.
HDMS_RETENTION_MODE=report
# Optional node_exporter textfile directory for job last-success metrics.
# HDMS_JOB_METRICS_DIR=/var/lib/node_exporter/textfile_collector

# --- Sessions -----------------------------------------------------------
HDMS_SESSION_TTL=25s
HDMS_ADMIN_SESSION_TTL=12h
HDMS_STAFF_SESSION_TTL=12h

# --- SMTP relay (required in production) --------------------------------
# Overdue reminders and the weekly digest go through the hospital relay.
# Production refuses to start with the development defaults.
HDMS_SMTP_HOST=smtp.hospital.local
HDMS_SMTP_PORT=587
HDMS_SMTP_USERNAME=hdms
HDMS_SMTP_PASSWORD=change-me-smtp-password
HDMS_SMTP_FROM_ADDRESS=hdms@hospital.org
HDMS_SMTP_REPLY_ADDRESS=counter@hospital.org

# --- Optional integrations ----------------------------------------------
HDMS_ENTRA_TENANT_ID=
HDMS_ENTRA_CLIENT_ID=
HDMS_ENTRA_CLIENT_SECRET=
HDMS_ENTRA_REDIRECT_URL=https://hdms.hospital.local/v1/staff/auth/microsoft/callback
HDMS_ENTRA_ALLOWED_EMAIL_DOMAINS=
HDMS_OTLP_ENDPOINT=

# --- Monitoring (5.5a) ----------------------------------------------------
# /metrics allowlist: comma-separated CIDRs allowed to scrape /metrics
# (plain IPs accepted as /32 or /128). Defaults to localhost only — set to
# the monitoring host's network. Caddy never routes /metrics at all; this
# gates direct scrapes of the API port.
HDMS_METRICS_ALLOW_CIDRS=127.0.0.1/32,::1/128
