[Unit]
Description=HDMS directory roster sync (6.3b/6.3c)
Documentation=file:///opt/hdms/docs/runbooks/directory-sync.md
Wants=postgresql.service
After=postgresql.service

[Service]
Type=oneshot
User=hdms
Group=hdms
EnvironmentFile=/etc/hdms/hdms.env
ExecStart=/opt/hdms/bin/hdms-cli directory-sync --apply
SyslogIdentifier=hdms-directory-sync
