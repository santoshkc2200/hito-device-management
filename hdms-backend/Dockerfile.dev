# Dev-only image: source is bind-mounted over this in docker-compose, and
# air rebuilds/restarts the binary on change. Not used for production
# builds — see Phase 5 for the deploy image.
FROM golang:1.26-alpine

RUN apk add --no-cache git

RUN go install github.com/air-verse/air@latest

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

EXPOSE 8443

CMD ["air", "-c", ".air.toml"]
